<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="motor_stop">
     <field name="MOTOR">0</field>
     <next>
     <block type="procedures_callnoreturn">
       <comment pinned="false" h="110" w="290">新的：兩個參數，順序是（左輪, 右輪）。填反了車子就往反方向轉。(50, 50) 兩輪一樣快 = 直走。</comment>
       <mutation name="開車"><arg name="左輪"></arg><arg name="右輪"></arg></mutation>
       <value name="ARG0">
       <block type="math_number">
         <field name="NUM">50</field>
       </block>
       </value>
       <value name="ARG1">
       <block type="math_number">
         <field name="NUM">50</field>
       </block>
       </value>
       <next>
       <block type="arduino_delay">
         <value name="DELAY_TIME">
         <shadow type="math_number">
           <field name="NUM">1000</field>
         </shadow>
         </value>
         <next>
         <block type="procedures_callnoreturn">
           <comment pinned="false" h="70" w="230">(20, 60) 左輪慢右輪快 = 往左彎。</comment>
           <mutation name="開車"><arg name="左輪"></arg><arg name="右輪"></arg></mutation>
           <value name="ARG0">
           <block type="math_number">
             <field name="NUM">20</field>
           </block>
           </value>
           <value name="ARG1">
           <block type="math_number">
             <field name="NUM">60</field>
           </block>
           </value>
           <next>
           <block type="arduino_delay">
             <value name="DELAY_TIME">
             <shadow type="math_number">
               <field name="NUM">1000</field>
             </shadow>
             </value>
             <next>
             <block type="procedures_callnoreturn">
               <comment pinned="false" h="70" w="230">(60, 20) 左快右慢 = 往右彎。</comment>
               <mutation name="開車"><arg name="左輪"></arg><arg name="右輪"></arg></mutation>
               <value name="ARG0">
               <block type="math_number">
                 <field name="NUM">60</field>
               </block>
               </value>
               <value name="ARG1">
               <block type="math_number">
                 <field name="NUM">20</field>
               </block>
               </value>
               <next>
               <block type="arduino_delay">
                 <value name="DELAY_TIME">
                 <shadow type="math_number">
                   <field name="NUM">1000</field>
                 </shadow>
                 </value>
                 <next>
                 <block type="procedures_callnoreturn">
                   <comment pinned="false" h="90" w="270">(50, −50) 一正一負 = 原地右轉。轉彎就是左右輪的速度差。</comment>
                   <mutation name="開車"><arg name="左輪"></arg><arg name="右輪"></arg></mutation>
                   <value name="ARG0">
                   <block type="math_number">
                     <field name="NUM">50</field>
                   </block>
                   </value>
                   <value name="ARG1">
                   <block type="math_number">
                     <field name="NUM">-50</field>
                   </block>
                   </value>
                   <next>
                   <block type="arduino_delay">
                     <value name="DELAY_TIME">
                     <shadow type="math_number">
                       <field name="NUM">500</field>
                     </shadow>
                     </value>
                     <next>
                     <block type="procedures_callnoreturn">
                       <mutation name="開車"><arg name="左輪"></arg><arg name="右輪"></arg></mutation>
                       <value name="ARG0">
                       <block type="math_number">
                         <field name="NUM">0</field>
                       </block>
                       </value>
                       <value name="ARG1">
                       <block type="math_number">
                         <field name="NUM">0</field>
                       </block>
                       </value>
                     </block>
                     </next>
                   </block>
                   </next>
                 </block>
                 </next>
               </block>
               </next>
             </block>
             </next>
           </block>
           </next>
         </block>
         </next>
       </block>
       </next>
     </block>
     </next>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
   </block>
   </next>
 </block>
 <block type="procedures_defnoreturn" x="20" y="300">
   <comment pinned="false" h="130" w="300">動力放變數時可以是負數，負的就倒退（寫成固定數字的積木只能 0–100，倒退要改方向）。範圍 −100～100。</comment>
   <mutation><arg name="左輪"></arg><arg name="右輪"></arg></mutation>
   <field name="NAME">開車</field>
   <statement name="STACK">
   <block type="motor_pwm">
     <field name="MOTOR">1</field>
     <field name="DIRECTION">FORWARD</field>
     <value name="PWM">
     <block type="variables_get">
       <field name="VAR">左輪</field>
     </block>
     </value>
     <next>
     <block type="motor_pwm">
       <field name="MOTOR">2</field>
       <field name="DIRECTION">FORWARD</field>
       <value name="PWM">
       <block type="variables_get">
         <field name="VAR">右輪</field>
       </block>
       </value>
     </block>
     </next>
   </block>
   </statement>
 </block>
</xml>
