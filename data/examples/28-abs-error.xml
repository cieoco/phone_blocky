<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <next>
   <block type="arduino_loop">
     <statement name="LOOP_BODY">
     <block type="plot_print">
       <comment pinned="false" h="100" w="270">距離 − 30 可能是負的；絕對值把負號拿掉，只看差多少。到 Plotter 看曲線。</comment>
       <field name="SERIES">誤差</field>
       <field name="UNIT">cm</field>
       <value name="VALUE">
       <block type="math_abs">
         <value name="VALUE">
         <block type="math_arithmetic">
           <field name="OP">MINUS</field>
           <value name="A">
           <block type="arduino_ultrasonic">
             <field name="TRIG">2</field>
             <field name="ECHO">33</field>
           </block>
           </value>
           <value name="B">
           <shadow type="math_number">
             <field name="NUM">30</field>
           </shadow>
           </value>
         </block>
         </value>
       </block>
       </value>
       <next>
       <block type="arduino_delay">
         <value name="DELAY_TIME">
         <shadow type="math_number">
           <field name="NUM">100</field>
         </shadow>
         </value>
       </block>
       </next>
     </block>
     </statement>
   </block>
   </next>
 </block>
</xml>
