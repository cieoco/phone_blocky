<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="oled_clear">
     <comment pinned="false" h="156" w="260">兩個模組共用 SDA21/SCL22、3.3V 與 GND，不接上層主控。免初始化；剛開始或讀取失敗為 -1。原始讀值不是 0–255 RGB，也不直接代表顏色名稱。</comment>
     <field name="ADDRESS">60</field>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
     <statement name="LOOP_BODY">
     <block type="oled_value">
       <field name="ADDRESS">60</field>
       <field name="ROW">0</field>
       <value name="VALUE">
       <block type="tcs34725_read">
         <field name="CHANNEL">r</field>
       </block>
       </value>
       <next>
       <block type="oled_value">
         <field name="ADDRESS">60</field>
         <field name="ROW">1</field>
         <value name="VALUE">
         <block type="tcs34725_read">
           <field name="CHANNEL">g</field>
         </block>
         </value>
         <next>
         <block type="oled_value">
           <field name="ADDRESS">60</field>
           <field name="ROW">2</field>
           <value name="VALUE">
           <block type="tcs34725_read">
             <field name="CHANNEL">b</field>
           </block>
           </value>
           <next>
           <block type="oled_value">
             <field name="ADDRESS">60</field>
             <field name="ROW">3</field>
             <value name="VALUE">
             <block type="tcs34725_read">
               <field name="CHANNEL">c</field>
             </block>
             </value>
             <next>
             <block type="arduino_delay">
               <value name="DELAY_TIME">
               <shadow type="math_number">
                 <field name="NUM">100</field>
               </shadow>
               </value>
             </block>
             </next>
           </block>
           </next>
         </block>
         </next>
       </block>
       </next>
     </block>
     </statement>
   </block>
   </next>
 </block>
</xml>
