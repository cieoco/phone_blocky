<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="blockly_func_declare">
     <comment pinned="false" h="100" w="270">功能 0：類比、勾「可回讀」。沒勾的話主機讀不到本板寫的值。</comment>
     <field name="IDX">0</field>
     <field name="KIND">ANALOG</field>
     <field name="READABLE">TRUE</field>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
     <statement name="LOOP_BODY">
     <block type="blockly_func_set">
       <comment pinned="false" h="100" w="270">把距離（cm，整數）寫給主機。數值範圍 −32768～32767；沒回波是 −1。</comment>
       <field name="IDX">0</field>
       <value name="VALUE">
       <block type="arduino_ultrasonic">
         <field name="TRIG">2</field>
         <field name="ECHO">33</field>
       </block>
       </value>
       <next>
       <block type="arduino_delay">
         <value name="DELAY_TIME">
         <shadow type="math_number">
           <field name="NUM">100</field>
         </shadow>
         </value>
       </block>
       </next>
     </block>
     </statement>
   </block>
   </next>
 </block>
</xml>
