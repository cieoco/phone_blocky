<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="servo_set">
     <field name="CH">1</field>
     <value name="DEG">
     <shadow type="math_number">
       <field name="NUM">90</field>
     </shadow>
     </value>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
     <statement name="LOOP_BODY">
     <block type="servo_set">
       <comment pinned="false" h="90" w="260">隨機整數：兩端都包含。範圍改 0–180 看看；不要超出 0–180。</comment>
       <field name="CH">1</field>
       <value name="DEG">
       <block type="math_random_int">
         <value name="FROM">
         <shadow type="math_number">
           <field name="NUM">30</field>
         </shadow>
         </value>
         <value name="TO">
         <shadow type="math_number">
           <field name="NUM">150</field>
         </shadow>
         </value>
       </block>
       </value>
       <next>
       <block type="arduino_delay">
         <value name="DELAY_TIME">
         <shadow type="math_number">
           <field name="NUM">800</field>
         </shadow>
         </value>
       </block>
       </next>
     </block>
     </statement>
   </block>
   </next>
 </block>
</xml>
