<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="motor_stop">
     <field name="MOTOR">0</field>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
     <statement name="LOOP_BODY">
     <block type="plot_print">
       <comment pinned="false" h="100" w="260">距離會畫到 Plotter（抽屜裡的「開啟獨立 Plotter」）。單位欄位只是圖上的標示。</comment>
       <field name="SERIES">距離</field>
       <field name="UNIT">cm</field>
       <value name="VALUE">
       <block type="arduino_ultrasonic">
         <field name="TRIG">2</field>
         <field name="ECHO">33</field>
       </block>
       </value>
       <next>
       <block type="controls_if">
         <comment pinned="false" h="110" w="270">條件每一圈重新判斷。20 可以改大改小；延遲 100 毫秒是量測節拍，不要設成 0。</comment>
         <value name="IF0">
         <block type="logic_compare">
           <field name="OP">LT</field>
           <value name="A">
           <block type="arduino_ultrasonic">
             <field name="TRIG">2</field>
             <field name="ECHO">33</field>
           </block>
           </value>
           <value name="B">
           <block type="math_number">
             <field name="NUM">20</field>
           </block>
           </value>
         </block>
         </value>
         <statement name="DO0">
         <block type="motor_stop">
           <field name="MOTOR">1</field>
         </block>
         </statement>
         <statement name="ELSE">
         <block type="motor_pwm">
           <field name="MOTOR">1</field>
           <field name="DIRECTION">FORWARD</field>
           <value name="PWM">
           <shadow type="math_number">
             <field name="NUM">40</field>
           </shadow>
           </value>
         </block>
         </statement>
         <next>
         <block type="arduino_delay">
           <value name="DELAY_TIME">
           <shadow type="math_number">
             <field name="NUM">100</field>
           </shadow>
           </value>
         </block>
         </next>
       </block>
       </next>
     </block>
     </statement>
   </block>
   </next>
 </block>
</xml>
