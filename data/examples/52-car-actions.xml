<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="motor_stop">
     <field name="MOTOR">0</field>
     <next>
     <block type="procedures_callnoreturn">
       <comment pinned="false" h="100" w="280">新的：副程式。主程式現在讀起來就是「前進、等、左轉、等、前進、等、停車」。</comment>
       <mutation name="前進"></mutation>
       <next>
       <block type="arduino_delay">
         <value name="DELAY_TIME">
         <shadow type="math_number">
           <field name="NUM">1000</field>
         </shadow>
         </value>
         <next>
         <block type="procedures_callnoreturn">
           <mutation name="左轉"></mutation>
           <next>
           <block type="arduino_delay">
             <value name="DELAY_TIME">
             <shadow type="math_number">
               <field name="NUM">400</field>
             </shadow>
             </value>
             <next>
             <block type="procedures_callnoreturn">
               <mutation name="前進"></mutation>
               <next>
               <block type="arduino_delay">
                 <value name="DELAY_TIME">
                 <shadow type="math_number">
                   <field name="NUM">1000</field>
                 </shadow>
                 </value>
                 <next>
                 <block type="procedures_callnoreturn">
                   <mutation name="停車"></mutation>
                 </block>
                 </next>
               </block>
               </next>
             </block>
             </next>
           </block>
           </next>
         </block>
         </next>
       </block>
       </next>
     </block>
     </next>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
   </block>
   </next>
 </block>
 <block type="procedures_defnoreturn" x="20" y="300">
   <comment pinned="false" h="130" w="300">哪一顆輪子裝反了，只要改這裡（例如把 FORWARD 改 BACKWARD），所有呼叫的地方一起修好。「右轉」這支沒用到，先備著。</comment>
   <field name="NAME">前進</field>
   <statement name="STACK">
   <block type="motor_pwm">
     <field name="MOTOR">1</field>
     <field name="DIRECTION">FORWARD</field>
     <value name="PWM">
     <shadow type="math_number">
       <field name="NUM">50</field>
     </shadow>
     </value>
     <next>
     <block type="motor_pwm">
       <field name="MOTOR">2</field>
       <field name="DIRECTION">FORWARD</field>
       <value name="PWM">
       <shadow type="math_number">
         <field name="NUM">50</field>
       </shadow>
       </value>
     </block>
     </next>
   </block>
   </statement>
 </block>
 <block type="procedures_defnoreturn" x="20" y="500">
   <field name="NAME">左轉</field>
   <statement name="STACK">
   <block type="motor_stop">
     <field name="MOTOR">1</field>
     <next>
     <block type="motor_pwm">
       <field name="MOTOR">2</field>
       <field name="DIRECTION">FORWARD</field>
       <value name="PWM">
       <shadow type="math_number">
         <field name="NUM">50</field>
       </shadow>
       </value>
     </block>
     </next>
   </block>
   </statement>
 </block>
 <block type="procedures_defnoreturn" x="20" y="700">
   <field name="NAME">右轉</field>
   <statement name="STACK">
   <block type="motor_pwm">
     <field name="MOTOR">1</field>
     <field name="DIRECTION">FORWARD</field>
     <value name="PWM">
     <shadow type="math_number">
       <field name="NUM">50</field>
     </shadow>
     </value>
     <next>
     <block type="motor_stop">
       <field name="MOTOR">2</field>
     </block>
     </next>
   </block>
   </statement>
 </block>
 <block type="procedures_defnoreturn" x="20" y="900">
   <field name="NAME">停車</field>
   <statement name="STACK">
   <block type="motor_stop">
     <field name="MOTOR">0</field>
   </block>
   </statement>
 </block>
</xml>
