<xml xmlns="https://developers.google.com/blockly/xml">
 <block type="arduino_setup" x="20" y="20">
   <statement name="SETUP_BODY">
   <block type="motor_stop">
     <field name="MOTOR">0</field>
     <next>
     <block type="controls_whileUntil">
       <comment pinned="false" h="150" w="300">「直到」迴圈：條件成立之前一直重複裡面的動作，成立就往下走。按鈕腳內建上拉電阻，沒按是 1、按下去通常讀到 0；如果你的接法相反，把 0 改成 1。</comment>
       <field name="MODE">UNTIL</field>
       <value name="BOOL">
       <block type="logic_compare">
         <field name="OP">EQ</field>
         <value name="A">
         <block type="lego_button">
           <field name="PIN">4</field>
         </block>
         </value>
         <value name="B">
         <block type="math_number">
           <field name="NUM">0</field>
         </block>
         </value>
       </block>
       </value>
       <statement name="DO">
       <block type="arduino_delay">
         <value name="DELAY_TIME">
         <shadow type="math_number">
           <field name="NUM">20</field>
         </shadow>
         </value>
       </block>
       </statement>
       <next>
       <block type="motor_pwm">
         <field name="MOTOR">1</field>
         <field name="DIRECTION">FORWARD</field>
         <value name="PWM">
         <shadow type="math_number">
           <field name="NUM">50</field>
         </shadow>
         </value>
         <next>
         <block type="arduino_delay">
           <value name="DELAY_TIME">
           <shadow type="math_number">
             <field name="NUM">2000</field>
           </shadow>
           </value>
           <next>
           <block type="motor_stop">
             <comment pinned="false" h="110" w="280">等待迴圈裡的延遲 20 毫秒是讓出時間給板子，不要拿掉。放在 setup 只跑一遍；想每次都重新等就改放 loop。</comment>
             <field name="MOTOR">1</field>
           </block>
           </next>
         </block>
         </next>
       </block>
       </next>
     </block>
     </next>
   </block>
   </statement>
   <next>
   <block type="arduino_loop">
   </block>
   </next>
 </block>
</xml>
